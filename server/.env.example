PORT=5174

# Logging
# LOG_HTTP=true
# LOG_HTTP_BODY=false
# LOG_TORBOX=false

# TorBox
TORBOX_BASE_URL=https://api.torbox.app
TORBOX_API_KEY=YOUR_TORBOX_API_KEY

# One or more Torznab API URLs. Recommended: put your Prowlarr/Jackett Torznab endpoint(s) here,
# including the apikey in the URL.
#
# JSON array format (recommended):
# INDEXERS_TORZNAB_URLS=["http://localhost:9696/1/api?apikey=YOURKEY"]
#
# Or pipe/comma/newline separated:
# INDEXERS_TORZNAB_URLS=http://localhost:9117/api/v2.0/indexers/all/results/torznab/api?apikey=YOURKEY
#
# Docker (Jackett container on the same compose network):
# INDEXERS_TORZNAB_URLS=http://jackett:9117/api/v2.0/indexers/all/results/torznab/api?apikey=YOURKEY
INDEXERS_TORZNAB_URLS=

# Auth (single-user)
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
AUTH_COOKIE_SECRET=change-me-to-a-long-random-string

# Cookie transport
# - In Docker, NODE_ENV=production by default, so cookies are marked Secure.
# - If you access the app over plain HTTP (e.g. http://LAN_IP:5175), browsers will drop Secure cookies,
#   causing /api to return 401 Unauthorized after a successful login.
# - Fix: use HTTPS (recommended) OR set this to false for HTTP-only LAN usage.
AUTH_COOKIE_SECURE=false
